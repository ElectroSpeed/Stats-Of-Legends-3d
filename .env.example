# === Riot Games API (SERVER-ONLY — ne jamais préfixer NEXT_PUBLIC_) ===
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Plateforme par défaut affichée côté client (publique, non sensible)
NEXT_PUBLIC_DEFAULT_PLATFORM=euw1

# === PostgreSQL (Prisma) ===
DATABASE_URL="postgresql://postgres:password@localhost:5432/stats_of_legends?schema=public"

# === Cache Redis ===
REDIS_URL=redis://localhost:6379

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Origines autorisées pour les appels API (CSV). Vide = même origine uniquement.
ALLOWED_ORIGINS=
