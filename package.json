{
  "name": "stats-of-legends",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme web immersive dédiée à League of Legends : statistiques (OP.GG-like), carte 3D de Runeterra et builder/theorycraft 3D.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "prepare": "prisma generate || true"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@prisma/client": "^7.9.1",
    "@tanstack/react-query": "^5.101.4",
    "ioredis": "^6.0.0",
    "zod": "^4.4.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "recharts": "^3.10.1",
    "zustand": "^5.0.0",
    "three": "^0.185.1",
    "@react-three/fiber": "^9.7.0",
    "@react-three/drei": "^10.7.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.169.0",
    "prisma": "^6.3.0",
    "sass": "^1.80.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "prettier": "^3.3.0",
    "vitest": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
